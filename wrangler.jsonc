{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drama-space-staging",
  "main": "vike:server-entry",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "env": {
    "production": {
      "name": "drama-space",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
