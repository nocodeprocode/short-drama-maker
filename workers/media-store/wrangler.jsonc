{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "short-drama-media-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "short-drama-maker-media"
    }
  ]
}
