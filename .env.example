# Copy to .env.local (gitignored). Vite loads .env.local automatically.
#
# Only VITE_* values are safe in the browser. Everything else is server-only.
# Never prefix a secret with VITE_. Never paste keys into chat.
#
# Where each value actually lives:
#   .env.local                          local Vite / CLI
#   supabase secrets set KEY=...        remote Edge Functions (when deployed)
#   wrangler secret put KEY             Cloudflare Workers (jobs, media-store, media container)
#
# The engine calls these providers for real. Missing keys fail closed.

# =============================================================================
# 1. Supabase — already required. Your .env.local already has these two.
#    Dashboard: https://supabase.com/dashboard/project/zdhbmvdprdyqzrmuxwiy
# =============================================================================

VITE_SUPABASE_URL=https://zdhbmvdprdyqzrmuxwiy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_API_URL=https://zdhbmvdprdyqzrmuxwiy.supabase.co/functions/v1/api

# Service role is injected automatically on deployed Edge Functions.
# Only put it in .env.local if you run the job runner against remote Postgres.
# Dashboard → Project Settings → API Keys → service_role (secret).
# SUPABASE_SERVICE_ROLE_KEY=

# Personal access token for the Supabase CLI (sbp_...). Not the service role key.
# Create at https://supabase.com/dashboard/account/tokens then:
#   npm run supabase:login
# SUPABASE_ACCESS_TOKEN=

# =============================================================================
# 2. OpenRouter — needed before real text / image / video generation.
#    Create a key: https://openrouter.ai/settings/keys
#    Privacy:      https://openrouter.ai/settings/privacy
#    Credits:      https://openrouter.ai/settings/credits
# =============================================================================

OPENROUTER_API_KEY=

# Account settings that are NOT env vars (do these in the dashboard):
#   - Content / prompt logging: off
#   - Do not opt in to training on inputs/outputs
#   - ZDR: enable for the groups you will actually call
#   - Data collection: deny
# Video jobs are not ZDR-eligible (the provider must keep the file until we download it).
# Our engine will also send provider.zdr + data_collection deny per request.
# Seedance / Wan may 404 if no ZDR endpoint exists — that is fail-closed, not a bug.
# Optional. Defaults to the Supabase OpenRouter webhook function.
# OPENROUTER_WEBHOOK_URL=https://zdhbmvdprdyqzrmuxwiy.supabase.co/functions/v1/webhooks-openrouter

# =============================================================================
# 3. ElevenLabs — needed before Voice Design, persistent voices, or the support agent.
#    API keys:  https://elevenlabs.io/app/settings/api-keys
#    Data use:  profile menu → Terms and privacy → Data use
#    Voices:    https://elevenlabs.io/app/voice-lab
# =============================================================================

ELEVENLABS_API_KEY=

# Public widget id. Safe to expose. Leave empty to keep the widget hidden.
# After `npm run agents:add`, paste the printed agent id here.
# Do not set this in production until the cookie notice mentions the third-party script.
VITE_ELEVENLABS_AGENT_ID=

# Account settings that are NOT env vars:
#   - Turn OFF “Improve the models for everyone”
#   - Do not enable Professional Voice Clone / instant clone of real people
#   - Isolated EU residency and Zero Retention Mode are Enterprise — we do not claim them

# =============================================================================
# 4. Stripe — needed before paid credits. Use TEST mode until launch.
#    Keys:     https://dashboard.stripe.com/test/apikeys
#    Webhooks: https://dashboard.stripe.com/test/webhooks
#    Sandbox:  `npx @stripe/cli sandbox create` if you do not have an account yet
# =============================================================================

# Restricted key (rk_test_...) preferred over a full secret key (sk_test_...).
# Server-only. Used by POST /billing/checkout. Test keys only until legal entity is complete.
# STRIPE_SECRET_KEY=

# Publishable key is only needed if we embed Stripe.js. Not used yet.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Signing secret (whsec_...). The Edge Function webhooks-stripe already verifies this.
# Local: `stripe listen --forward-to http://127.0.0.1:54321/functions/v1/webhooks-stripe`
# Remote (after functions are deployed):
#   https://zdhbmvdprdyqzrmuxwiy.supabase.co/functions/v1/webhooks-stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Operator email for `npm run admin:set`. Must already exist in Auth. Do not invent one.
# ADMIN_EMAIL=

# =============================================================================
# 5. Cloudflare media store — R2 + Worker (required before OpenRouter can fetch media)
# =============================================================================

# Enable R2 in the dashboard first if wrangler returns code 10042:
# https://dash.cloudflare.com/8f525ba2728395965393892e024556ab/r2
#
# Then:
#   npx wrangler r2 bucket create short-drama-maker-media --location enam
#   npx wrangler secret put MEDIA_SIGNING_SECRET --cwd workers/media-store < /tmp/media-signing-secret
#   npx wrangler secret put MEDIA_STORE_TOKEN --cwd workers/media-store < /tmp/media-store-token
#   npx wrangler deploy --cwd workers/media-store

MEDIA_STORE_URL=
MEDIA_SIGNING_SECRET=
MEDIA_STORE_TOKEN=

# Local validation only. Writes real provider bytes to disk and mints data: URLs.
# ASSET_DIR=assets/engine

# =============================================================================
# 6. Media worker — containerized ffmpeg render (worker/). Optional locally.
#    When both are set the job runner renders through the container instead of
#    local ffmpeg. Same bytes either way.
#      npx wrangler secret put MEDIA_WORKER_TOKEN --cwd worker
#      npx wrangler deploy --cwd worker
# =============================================================================
# MEDIA_WORKER_URL=https://short-drama-media-worker.<account>.workers.dev
# MEDIA_WORKER_TOKEN=
# Override the bundled music library root (default: cwd/assets/music).
# MUSIC_ROOT=
# Override the caption burn-in font (default: DejaVu on Linux, Arial on macOS).
# CAPTION_FONT_PATH=

# Shared secret the OpenRouter webhook must present (X-Webhook-Secret header or ?secret=).
# Set the same value on the Edge Function: supabase secrets set OPENROUTER_WEBHOOK_SECRET=...
# OPENROUTER_WEBHOOK_SECRET=

# Turnstile (bot protection on signup / privacy request). Cookie policy is essential-only.
# When both are set, signup and password reset require a successful siteverify.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=drama-space.example

# After LEGAL_ENTITY in src/legal/entity.ts is filled by a real operator (not invented),
# set this on the Supabase API so live Stripe keys are accepted. Test keys always work.
# LEGAL_ENTITY_COMPLETE=1

# Hosted job runner (Cloudflare Worker cron + wake). Same createEngine as `npm run jobs`.
# JOBS_WAKE_URL=https://drama-space-jobs.despianative.workers.dev
# JOBS_WAKE_SECRET=
# SUPABASE_URL=https://zdhbmvdprdyqzrmuxwiy.supabase.co
#
# After the media container is deployed, the orchestrator wakes it to shoot / ingest / cut:
#   npx wrangler secret put MEDIA_WORKER_TOKEN --config workers/jobs/wrangler.jsonc
#   npx wrangler secret put MEDIA_WORKER_URL --config workers/jobs/wrangler.jsonc
# MEDIA_WORKER_URL=https://short-drama-media-worker.despianative.workers.dev

# Merchant of Record is a legal placeholder. If we stay on Stripe, no extra MoR keys.
