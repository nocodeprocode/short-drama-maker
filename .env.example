# Copy to .env.local and fill in values from the Supabase project Connect panel.
# Publishable keys are safe to expose in the browser. Never add a secret or service_role key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never prefix this with VITE_ or ship it to the browser.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
