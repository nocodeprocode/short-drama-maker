{
  "name": "short-drama-maker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev --host 0.0.0.0 --port 43123",
    "build": "vike build",
    "preview": "vike build && vike preview --host 0.0.0.0 --port 43123",
    "deploy:staging": "DRAMA_CF=1 vike build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:prod": "DRAMA_CF=1 vike build && wrangler deploy --config dist/server/wrangler.json --env production",
    "deploy:jobs": "wrangler deploy --config workers/jobs/wrangler.jsonc",
    "deploy:media-store": "wrangler deploy --config workers/media-store/wrangler.jsonc",
    "deploy:media": "wrangler deploy --config worker/wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "tsx scripts/live-suite.ts",
    "test:live-drama": "tsx scripts/live-drama.ts",
    "test:live-prod": "tsx scripts/live-prod.ts",
    "test:live-show": "tsx scripts/live-show.ts",
    "test:live-final": "tsx scripts/live-final.ts",
    "test:live-long": "tsx scripts/live-long.ts",
    "test:live-hq": "tsx scripts/live-hq.ts",
    "test:live-lock": "tsx scripts/live-lock.ts",
    "music:library": "tsx scripts/generate-music-library.ts",
    "test:engine": "tsx scripts/live-suite.ts",
    "worker": "tsx worker/src/server.ts",
    "jobs": "tsx scripts/job-runner.ts",
    "admin:set": "tsx scripts/set-admin.ts",
    "supabase:login": "tsx scripts/supabase-login.ts",
    "typecheck": "tsc --noEmit",
    "validate:providers": "tsx scripts/validate-providers.ts",
    "media-store:types": "wrangler types --cwd workers/media-store",
    "agents:status": "elevenlabs agents status",
    "agents:push": "elevenlabs agents push",
    "agents:add": "elevenlabs agents add \"Short Drama Maker Support\" --from-file agent_configs/short-drama-maker-support.json"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@untitledui/icons": "^0.0.22",
    "react": "^19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vike": "^0.4.260",
    "vike-react": "^0.6.25"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@elevenlabs/cli": "^1.1.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "supabase": "^2.116.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
