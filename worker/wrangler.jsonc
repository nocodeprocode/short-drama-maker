{
  "name": "short-drama-media-worker",
  "main": "src/container.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "MediaWorker",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_WORKER",
        "class_name": "MediaWorker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MediaWorker"]
    }
  ]
}
